{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.6",
  "body": [
    {
      "type": "TextBlock",
      "text": "${songTitle}",
      "weight": "Bolder",
      "size": "Medium",
      "wrap": true,
      "maxLines": 1
    },
    {
      "type": "TextBlock",
      "text": "${artist}",
      "isSubtle": true,
      "spacing": "None",
      "wrap": true,
      "maxLines": 1
    },
    {
      "type": "TextBlock",
      "$when": "${$host.widgetSize==\"medium\"}",
      "text": "${lyrics}",
      "wrap": true,
      "maxLines": 6,
      "size": "Small",
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "$when": "${$host.widgetSize==\"large\"}",
      "text": "${lyrics}",
      "wrap": true,
      "maxLines": 14,
      "size": "Small",
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "$when": "${$host.widgetSize==\"large\"}",
      "text": "Source: ${source}",
      "isSubtle": true,
      "size": "Small",
      "spacing": "Small"
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Listen Again",
      "verb": "listenNow"
    }
  ]
}
